{
  "name": "@kinnet/a2a",
  "version": "0.3.4",
  "description": "Bridge between Kinnet participant records and A2A agent cards (.well-known/agent.json): serve and consume signed participant records alongside agent cards.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "kinnet",
    "a2a",
    "agent-card",
    "well-known",
    "interop"
  ],
  "homepage": "https://github.com/HumanMeetsAi/kinnet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanMeetsAi/kinnet.git",
    "directory": "packages/a2a"
  },
  "bugs": {
    "url": "https://github.com/HumanMeetsAi/kinnet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@kinnet/protocol": "workspace:^",
    "@kinnet/trust": "workspace:^",
    "@kinnet/verify": "workspace:^"
  },
  "devDependencies": {
    "@kinnet/crypto": "workspace:^"
  }
}
