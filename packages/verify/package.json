{
  "name": "@kinnet/verify",
  "version": "0.9.2",
  "description": "Inbound-request verification for services receiving agent traffic: verify an RFC 9421 HTTP Message Signature and the caller's represents chain in ~5 lines (Node/Express + edge runtimes).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kinnet-verify": "./bin/kinnet-verify.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "kinnet",
    "agent-verification",
    "middleware",
    "express",
    "rfc9421"
  ],
  "homepage": "https://github.com/HumanMeetsAi/kinnet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanMeetsAi/kinnet.git",
    "directory": "packages/verify"
  },
  "bugs": {
    "url": "https://github.com/HumanMeetsAi/kinnet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@kinnet/crypto": "workspace:^",
    "@kinnet/protocol": "workspace:^",
    "@kinnet/trust": "workspace:^"
  }
}
