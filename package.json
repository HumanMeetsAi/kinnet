{
  "name": "kinnet",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "check": "pnpm run typecheck && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@kinnet/a2a": "workspace:*",
    "@kinnet/crypto": "workspace:*",
    "@kinnet/discovery-client": "workspace:*",
    "@kinnet/protocol": "workspace:*",
    "@kinnet/trust": "workspace:*",
    "@kinnet/verify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
